    <bpmn:textAnnotation id="TextAnnotation_19b995a">
      <bpmn:text>Μέσω gov.gr / Kέντρα Κοινότητας / Κ.Ε.Π.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0upbnmq">
      <bpmn:text>Από τον θεράποντα ιατρό του πολίτη</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bv1t7f">
      <bpmn:text>Γνωμάτευση παθήσεων από την Υγειονομική Επιτροπή</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_01ah3ok">
      <bpmn:text>Αποστολή γραπτού μηνήματος στον πολίτη</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_062u0ve">
      <bpmn:text>Για τυχόν λήψη παροχών/ ωφελημάτων</bpmn:text>
